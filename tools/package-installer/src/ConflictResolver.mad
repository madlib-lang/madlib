import type { Wish } from "Wish"
import type { Config } from "./Config"
import type { LockEntry } from "./MadlibLock"
import type { MadlibDotJson } from "./MadlibDotJson"
import type { MadlibLock } from "./MadlibLock"

import Dictionary from "Dictionary"
import IO from "IO"
import List from "List"
import String from "String"
import Terminal from "Terminal"
import type { Maybe } from "Maybe"
import { Just, Nothing, fromMaybe } from "Maybe"
import { always } from "Function"
import { Wish } from "Wish"
import { andDo } from "Monad"
import { discardError, mapRej } from "Wish"

import Color from "./Color"
import ConflictAnalysis from "./ConflictAnalysis"
import Constants from "./Constants"
import Version from "./Version"
import { sanitizeUrl } from "./URL"


// (version, url) — one candidate per distinct version of a conflicted package
type VersionChoice = VersionChoice(String, String)

// Build one VersionChoice per distinct version of `name` found in lock packages.
versionChoices :: String -> Dictionary String LockEntry -> List VersionChoice
export versionChoices = (name, packages) =>
  Dictionary.reduce(
    (url, entry, acc) =>
      entry.name == name && !List.any(
        (vc) => where(vc) { VersionChoice(v, _) => v == entry.version },
        acc
      )
        ? [...acc, VersionChoice(entry.version, url)]
        : acc,
    [],
    packages
  )


pickForConflict :: String -> Dictionary String LockEntry -> List String -> String -> Wish {} VersionChoice
pickForConflict = (rootLabel, packages, rootDeps, conflictedName) => {
  choices = versionChoices(conflictedName, packages)
  options = map(
    (vc) => where(vc) {
      VersionChoice(version, _) =>
        #[vc, ConflictAnalysis.findPathsToVersion(conflictedName, version, packages, [], rootDeps)]
    },
    choices
  )

  totalMenuLines = 4 + List.reduce(
    (sum, opt) => where(opt) { #[_, chains] => sum + 1 + List.length(chains) },
    0,
    options
  ) + 2

  selectedIndex = 0
  renderedLines = 0
  handlerId :: Maybe Terminal.HandlerId
  handlerId = Nothing

  render = () => {
    if (renderedLines > 0) {
      IO.put(Terminal.moveCursorUp(renderedLines))
    }
    IO.put(Terminal.clearToEndOfScreen({}))
    IO.putLine("")
    IO.putLine(`  ${Color.yellow("!")} Conflict: ${Color.bold(conflictedName)} — ${show(List.length(choices))} versions installed`)
    IO.putLine("  Select version to keep in madlib_modules/:")
    IO.putLine("")
    List.reduce(
      (idx, opt) => {
        #[VersionChoice(version, _), chains] = opt
        isSelected = idx == selectedIndex
        marker = isSelected ? Color.bold(Color.green(">")) : " "
        versionStr = isSelected ? Color.bold(Color.green(version)) : version
        IO.putLine(`    ${marker} ${versionStr}`)
        List.forEach(
          (path) => IO.putLine(`        ${ConflictAnalysis.pathToChainString(packages, rootLabel, path)}`),
          chains
        )
        return idx + 1
      },
      0,
      options
    )
    IO.putLine("")
    IO.putLine("  ↑/↓ navigate · Enter confirm · Ctrl-C skip")
    renderedLines := totalMenuLines
  }

  return Wish((bad, good) => {
    Terminal.enableTTYRawMode({})
    render({})

    n = List.length(options)

    cleanup = () => {
      where(handlerId) {
        Just(hid) =>
          Terminal.clearKeyPressedHandler(hid)

        Nothing =>
          {}
      }
      Terminal.disableTTYRawMode({})
    }

    cb = (key) => if (key == "\x1b[A" || key == "k") do {
      selectedIndex := selectedIndex > 0 ? selectedIndex - 1 : n - 1
      render({})
    } else if (key == "\x1b[B" || key == "j") do {
      selectedIndex := selectedIndex < n - 1 ? selectedIndex + 1 : 0
      render({})
    } else if (key == "\r") do {
      cleanup({})
      where(List.nth(selectedIndex, choices)) {
        Just(choice) =>
          good(choice)

        Nothing =>
          bad({})
      }
    } else if (key == "\x03") do {
      cleanup({})
      bad({})
    } else {
      {}
    }

    handlerId := Just(Terminal.onKeyPressed(cb))

    return cleanup
  })
}


copyChosenVersion :: Config -> String -> VersionChoice -> Wish {} {}
copyChosenVersion = (config, conflictedName, vc) => where(vc) {
  VersionChoice(_, url) =>
    config.remove(
      `${Constants.MADLIB_MODULES_PATH}${conflictedName}/`,
      { recursive: true }
    )
      |> discardError(always({}))
      |> chain((_) => config.copy(
        `${Constants.TEMPORARY_MODULES_PATH}${sanitizeUrl(url)}/`,
        `${Constants.MADLIB_MODULES_PATH}${conflictedName}/`,
        { recursive: true, overwrite: true, exclude: [] }
      ) |> mapRej(always({})))
}


// Prune `packages` to remove all entries for `conflictedName` except `chosenUrl`.
pruneConflict :: String -> String -> Dictionary String LockEntry -> Dictionary String LockEntry
export pruneConflict = (conflictedName, chosenUrl, packages) =>
  Dictionary.reduce(
    (url, entry, acc) =>
      entry.name == conflictedName && url != chosenUrl
        ? acc
        : Dictionary.insert(url, entry, acc),
    Dictionary.empty,
    packages
  )


resolveConflict :: Config -> String -> Dictionary String LockEntry -> List String -> String -> Wish {} (Dictionary String LockEntry)
resolveConflict = (config, rootLabel, packages, rootDeps, conflictedName) =>
  pickForConflict(rootLabel, packages, rootDeps, conflictedName)
    |> chain(
        (chosenVc) => where(chosenVc) {
          VersionChoice(_, chosenUrl) =>
            copyChosenVersion(config, conflictedName, chosenVc)
              |> andDo(of(pruneConflict(conflictedName, chosenUrl, packages)))
        }
      )
    |> discardError(always(packages))


runInteractive :: Config -> String -> Dictionary String LockEntry -> List String -> List String -> Wish {} (Dictionary String LockEntry)
runInteractive = (config, rootLabel, packages, rootDeps, conflictedNames) => {
  IO.putLine("")
  IO.putLine(Color.bold(Color.yellow("Dependency conflicts detected — interactive resolution:")))
  return List.reduceM(
    (dict, name) => resolveConflict(config, rootLabel, dict, rootDeps, name),
    packages,
    conflictedNames
  )
}


staticReport :: MadlibDotJson -> MadlibLock -> Wish {} {}
staticReport = (madlibDotJson, lock) => {
  ConflictAnalysis.analyze(madlibDotJson, lock)
  return of({})
}


// Returns the lock file updated to reflect the user's resolution choices.
// On TTY: interactive picker, chosen URLs kept, others pruned from the lock.
// Non-TTY: static report printed, original lock returned unchanged.
run :: Config -> MadlibDotJson -> MadlibLock -> Wish {} MadlibLock
export run = (config, madlibDotJson, lock) => {
  isTTY = config.isTTY({})
  rootLabel = `${Color.bold(madlibDotJson.name)}@${Version.showVersion(madlibDotJson.version)}`
  rootDeps = madlibDotJson.dependencies |> fromMaybe([]) |> map(.url)
  packages = lock.packages
  conflictedNames = ConflictAnalysis.findConflictedNames(packages)

  return isTTY && List.length(conflictedNames) > 0
    ? runInteractive(config, rootLabel, packages, rootDeps, conflictedNames)
        |> map((updatedPackages) => ({ ...lock, packages: updatedPackages }))
    : staticReport(madlibDotJson, lock) |> andDo(of(lock))
}
