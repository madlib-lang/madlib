import { ErrorWithMessage, assertEquals, test } from "Test"
import { bichain, good, bad, mapRej } from "Wish"
import { always } from "Function"
import { Just } from "Maybe"
import ByteArray from "ByteArray"
import Dictionary from "Dictionary"
import List from "List"
import IO from "IO"
import String from "String"
import { OK } from "Http"

import type { Config } from "./Config"
import { load, write, empty, normalizeDependencies } from "./MadlibLock"


VALID_LOCK_JSON = `{
  "lockfileVersion": 1,
  "packages": {
    "https://example.com/foo.zip": {
      "name": "foo",
      "version": "1.2.3",
      "buildHash": "abc",
      "versionHash": "def",
      "dependencies": []
    }
  }
}`

baseConfig :: Config
baseConfig = {
  readFile: (_) => good(""),
  writeFile: (_, _) => good({}),
  writeBytes: (_, _) => good({}),
  readDir: (_) => good([]),
  createDir: (_, _) => good({}),
  remove: (_, _) => good({}),
  copy: (_, _, _) => good({}),
  rename: (_, _) => good({}),
  unzip: (_, _) => good({}),
  exec: (_, _, _) => good({ exitCode: 0, stdout: "", stderr: "" }),
  exists: (_) => good(true),
  getBytes: (_) => good({ headers: [], status: OK, body: ByteArray.empty() }),
  getBytesWithProgress: (_, _) => good({ headers: [], status: OK, body: ByteArray.empty() }),
  isTTY: (_) => false,
  now: (_) => 0,
}


test("empty - lockfileVersion is 1", (_) =>
  assertEquals(empty.lockfileVersion, 1)
)

test("empty - packages dictionary is empty", (_) =>
  assertEquals(Dictionary.length(empty.packages), 0)
)

test("load - parses lockfileVersion from valid JSON", (_) => {
  config = { ...baseConfig, readFile: (_) => good(VALID_LOCK_JSON) }
  return load(config, "./madlib.lock")
    |> mapRej(always(ErrorWithMessage("load failed")))
    |> chain((lock) => assertEquals(lock.lockfileVersion, 1))
})

test("load - parses package entry from valid JSON", (_) => {
  config = { ...baseConfig, readFile: (_) => good(VALID_LOCK_JSON) }
  return load(config, "./madlib.lock")
    |> mapRej(always(ErrorWithMessage("load failed")))
    |> chain((lock) =>
        assertEquals(
          Dictionary.get("https://example.com/foo.zip", lock.packages),
          Just({ name: "foo", version: "1.2.3", buildHash: "abc", versionHash: "def", dependencies: [] })
        )
       )
})

test("load - fails when file is not found", (_) => {
  config = { ...baseConfig, readFile: (_) => bad(IO.UnknownError) }
  return load(config, "./madlib.lock")
    |> bichain(
        (err) => assertEquals(String.contains("not found", err), true),
        (_) => bad(ErrorWithMessage("expected load to fail but it succeeded"))
       )
})

test("load - fails with diagnostic for malformed JSON", (_) => {
  config = { ...baseConfig, readFile: (_) => good("not valid json at all") }
  return load(config, "./madlib.lock")
    |> bichain(
        (err) => assertEquals(String.contains("malformed", err), true),
        (_) => bad(ErrorWithMessage("expected load to fail but it succeeded"))
       )
})

test("write - invokes writeFile with content containing the package name", (_) => {
  written = ""
  lock = {
    lockfileVersion: 1,
    packages: Dictionary.fromList([
      #["https://example.com/mypkg.zip", {
        name: "mypkg",
        version: "1.0.0",
        buildHash: "aaa",
        versionHash: "bbb",
        dependencies: [],
      }],
    ]),
  }
  config = {
    ...baseConfig,
    writeFile: (_, content) => {
      written := content
      return good({})
    },
  }
  return write(config, "./madlib.lock", lock)
    |> mapRej(always(ErrorWithMessage("write failed")))
    |> chain((_) => assertEquals(String.contains(`"mypkg"`, written), true))
})

test("write - serialized content includes lockfileVersion", (_) => {
  written = ""
  config = {
    ...baseConfig,
    writeFile: (_, content) => {
      written := content
      return good({})
    },
  }
  return write(config, "./madlib.lock", empty)
    |> mapRej(always(ErrorWithMessage("write failed")))
    |> chain((_) => assertEquals(String.contains(`"lockfileVersion"`, written), true))
})

test("round-trip: write then load recovers lockfileVersion", (_) => {
  stored = ""
  lock = {
    lockfileVersion: 1,
    packages: Dictionary.fromList([
      #["https://example.com/roundtrip.zip", {
        name: "roundtrip",
        version: "2.0.0",
        buildHash: "hash1",
        versionHash: "hash2",
        dependencies: ["https://example.com/dep.zip"],
      }],
    ]),
  }
  config = {
    ...baseConfig,
    readFile: (_) => good(stored),
    writeFile: (_, content) => {
      stored := content
      return good({})
    },
  }
  return write(config, "./madlib.lock", lock)
    |> mapRej(always("write failed"))
    |> chain((_) => load(config, "./madlib.lock"))
    |> mapRej(always(ErrorWithMessage("round-trip failed")))
    |> chain((reloaded) => assertEquals(reloaded.lockfileVersion, 1))
})

// ---- normalizeDependencies ---------------------------------------------------

STUDY_V1_URL = "https://example.com/study-v1.zip"
STUDY_V3_URL = "https://example.com/study-v3.zip"
DYE_URL      = "https://example.com/dye.zip"

ALL_PACKAGES = Dictionary.fromList([
  #[STUDY_V1_URL, { name: "study", version: "0.0.1", buildHash: "aaa", versionHash: "bbb", dependencies: [] }],
  #[STUDY_V3_URL, { name: "study", version: "0.0.3", buildHash: "ccc", versionHash: "ddd", dependencies: [] }],
  #[DYE_URL,      { name: "dye",   version: "1.0.0", buildHash: "eee", versionHash: "fff", dependencies: [STUDY_V1_URL] }],
])

RESOLVED_LOCK = {
  lockfileVersion: 1,
  packages: Dictionary.fromList([
    #[STUDY_V3_URL, { name: "study", version: "0.0.3", buildHash: "ccc", versionHash: "ddd", dependencies: [] }],
    #[DYE_URL,      { name: "dye",   version: "1.0.0", buildHash: "eee", versionHash: "fff", dependencies: [STUDY_V1_URL] }],
  ]),
}

test("normalizeDependencies - replaces pruned dep URL with surviving URL in dependents", (_) => {
  result = normalizeDependencies(ALL_PACKAGES, RESOLVED_LOCK)
  dyeEntry = Dictionary.get(DYE_URL, result.packages)
  return assertEquals(dyeEntry, Just({ name: "dye", version: "1.0.0", buildHash: "eee", versionHash: "fff", dependencies: [STUDY_V3_URL] }))
})

test("normalizeDependencies - pruned URL does not appear in any dependencies list", (_) => {
  result = normalizeDependencies(ALL_PACKAGES, RESOLVED_LOCK)
  allDeps = Dictionary.reduce(
    (_, entry, acc) => [...acc, ...entry.dependencies],
    [],
    result.packages
  )
  return assertEquals(List.any((u) => u == STUDY_V1_URL, allDeps), false)
})

test("normalizeDependencies - surviving entry is untouched when no conflicts", (_) => {
  noConflict = Dictionary.fromList([
    #[STUDY_V3_URL, { name: "study", version: "0.0.3", buildHash: "ccc", versionHash: "ddd", dependencies: [] }],
  ])
  lock = { lockfileVersion: 1, packages: noConflict }
  result = normalizeDependencies(noConflict, lock)
  return assertEquals(Dictionary.length(result.packages), 1)
})

test("normalizeDependencies - lockfileVersion is preserved", (_) => {
  result = normalizeDependencies(ALL_PACKAGES, RESOLVED_LOCK)
  return assertEquals(result.lockfileVersion, 1)
})

test("normalizeDependencies - keeps dep URL unchanged when no survivor found", (_) => {
  // DYE depends on a URL that never had a surviving counterpart
  orphanUrl = "https://example.com/gone.zip"
  pkgs = Dictionary.fromList([
    #[DYE_URL, { name: "dye", version: "1.0.0", buildHash: "eee", versionHash: "fff", dependencies: [orphanUrl] }],
  ])
  lock = { lockfileVersion: 1, packages: pkgs }
  result = normalizeDependencies(Dictionary.fromList([
    #[orphanUrl, { name: "gone", version: "1.0.0", buildHash: "g", versionHash: "h", dependencies: [] }],
    #[DYE_URL,   { name: "dye",  version: "1.0.0", buildHash: "eee", versionHash: "fff", dependencies: [orphanUrl] }],
  ]), lock)
  dyeEntry = Dictionary.get(DYE_URL, result.packages)
  return assertEquals(dyeEntry, Just({ name: "dye", version: "1.0.0", buildHash: "eee", versionHash: "fff", dependencies: [orphanUrl] }))
})


// ---- round-trip --------------------------------------------------------------

test("round-trip: write then load recovers package entry", (_) => {
  stored = ""
  originalEntry = {
    name: "roundtrip",
    version: "2.0.0",
    buildHash: "hash1",
    versionHash: "hash2",
    dependencies: ["https://example.com/dep.zip"],
  }
  lock = {
    lockfileVersion: 1,
    packages: Dictionary.fromList([
      #["https://example.com/roundtrip.zip", originalEntry],
    ]),
  }
  config = {
    ...baseConfig,
    readFile: (_) => good(stored),
    writeFile: (_, content) => {
      stored := content
      return good({})
    },
  }
  return write(config, "./madlib.lock", lock)
    |> mapRej(always("write failed"))
    |> chain((_) => load(config, "./madlib.lock"))
    |> mapRej(always(ErrorWithMessage("round-trip failed")))
    |> chain((reloaded) =>
        assertEquals(
          Dictionary.get("https://example.com/roundtrip.zip", reloaded.packages),
          Just(originalEntry)
        )
       )
})
