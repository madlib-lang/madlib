import type { Wish } from "Wish"
import type { Maybe } from "Maybe"
import List from "List"
import { bad, bichain, chainRej, discardError, mapRej, parallelN } from "Wish"
import IO from "IO"
import { Just, Nothing, fromMaybe } from "Maybe"
import Process from "Process"
import Tuple from "Tuple"
import { always, identity, ifElse, not } from "Function"
import { andDo } from "Monad"
import { liftA3 } from "Applicative"
import Dictionary from "Dictionary"
import type { Context } from "./Context"
import type { Dependency } from "./Dependency"
import type { MadlibDotJson } from "./MadlibDotJson"
import type { VersionDotLock } from "./VersionDotLock"
import type { Validate, ValidationInput, ValidationOutput } from "./Validate"
import type { Config } from "./Config"
import type { Reporter } from "./Reporter"
import { addInstalledPackage, addLockEntry, hasPackageBeenInstalled } from "./Context"
import MadlibLock from "./MadlibLock"
import Version from "./Version"
import MadlibDotJson from "./MadlibDotJson"
import VersionDotLock from "./VersionDotLock"
import {
  BuildHashCouldNotBeGenerated,
  CopyToMadlibModulesFailed,
  MadlibDotJsonCouldNotBeLoaded,
  NotValid,
  Valid,
  ValidationError,
  VersionDotLockMissing,
  failWithRecoverable,
  unsafeGetValidationValue,
  validate,
  warningMessage,
  errorMessage
} from "./Validate"
import Constants from "./Constants"
import { DownloadError, Downloaded, downloadIfNotCached } from "./Download"
import { FromCache, FromRemote, downloadErrorMessage } from "./Download"
import { hashVersion } from "./Hash"
import Reporter from "./Reporter"
import ConflictResolver from "./ConflictResolver"
import { AnyVersion } from "./Version"
import { sanitizeUrl } from "./URL"



copyPackageToMadlibModules :: Config -> Dependency -> Wish IO.Error {}
copyPackageToMadlibModules = (config, dependency) => pipe(
  (d) => ({
    destination: `${Constants.MADLIB_MODULES_PATH}${fromMaybe("", d.name)}`,
    source: `${Constants.TEMPORARY_MODULES_PATH}${d.sanitizedUrl}/`,
  }),
  (paths) => config.copy(paths.source, paths.destination, {
    recursive: true,
    overwrite: true,
    exclude: [],
  })
)(dependency)


installNodeModules :: Config -> String -> Wish {} String
installNodeModules = (config, pkgName) => pipe(
  (name) => `${Constants.MADLIB_MODULES_PATH}${name}/`,
  (path) => config.exists(`${path}package.json`) |> andDo(of(path)),
  mapRej(always("")),
  map((path) => ["install", path,]),
  chain(
    pipe(
      config.exec("npm", $, Process.DEFAULT_COMMAND_OPTIONS),
      mapRej(.stderr)
    )
  ),
  map(.stdout),
  map(IO.putLineAndPass(`nodejs modules installed for '${pkgName}'`)),
  discardError(IO.putLineAndPass(`No node modules to install for '${pkgName}'`))
)(pkgName)


projectBaseUrl :: Dependency -> String
projectBaseUrl = (dependency) => `${Constants.TEMPORARY_MODULES_PATH}${dependency.sanitizedUrl}`


readMadlibDotJson :: Config -> Dependency -> Wish {} (Validate MadlibDotJson)
readMadlibDotJson = (config, dependency) => pipe(
  MadlibDotJson.load(config),
  map(Valid),
  discardError(
    pipe(
      MadlibDotJsonCouldNotBeLoaded,
      ValidationError([], $, Nothing)
    )
  )
)(`${projectBaseUrl(dependency)}/madlib.json`)


readVersionDotLock :: Config -> Dependency -> Wish {} (Validate (Maybe VersionDotLock))
readVersionDotLock = (config, dependency) => pipe(
  (d) => VersionDotLock.load(config, `${projectBaseUrl(d)}/version.lock`),
  map(
    pipe(
      Just,
      Valid
    )
  ),
  discardError(always(NotValid([VersionDotLockMissing,], Nothing)))
)(dependency)


computeBuildHash :: Config -> Dependency -> Wish {} (Validate String)
computeBuildHash = (config, dependency) => pipe(
  (d) => config.exec(
    "madlib",
    ["package", "generate-hash", "-i", projectBaseUrl(d),],
    Process.DEFAULT_COMMAND_OPTIONS
  ),
  map(.stdout),
  map(Valid),
  discardError(always(NotValid([BuildHashCouldNotBeGenerated,], "")))
)(dependency)


prepareValidationInput :: Config -> Dependency -> Wish {} (Validate ValidationInput)
prepareValidationInput = (config, dependency) => pipe(
  readVersionDotLock(config),
  map(
    liftA3(
      (versionDotLock, computedBuildHash, madlibDotJson) => ({
        madlibDotJson,
        versionDotLock,
        computedVersionHash: hashVersion(madlibDotJson.version),
        computedBuildHash,
      })
    )
  ),
  ap($, computeBuildHash(config, dependency)),
  ap($, readMadlibDotJson(config, dependency))
)(dependency)


copyPackageFromTmp :: Config -> Validate ValidationOutput -> Wish {} (Validate ValidationOutput)
copyPackageFromTmp = (config, validationResult) => where (validationResult) {
  ValidationError(_, _, _) =>
    of(validationResult)

  _ =>
    pipe(
      unsafeGetValidationValue,
      ifElse(
        .shouldCopy,
        pipe(
          .dependency,
          copyPackageToMadlibModules(config),
          andDo(of(validationResult))
        ),
        always(of(validationResult))
      ),
      discardError(
        (_) => pipe(
          unsafeGetValidationValue,
          .madlibDotJson,
          .name,
          (n) => failWithRecoverable(
            CopyToMadlibModulesFailed(
              `Failed to copy '${n}'`
            ),
            validationResult
          )
        )(validationResult)
      )
    )(validationResult)
}

tryRecovery :: Validate a -> Validate a
tryRecovery = (validation) => where (validation) {
  ValidationError(_, _, Just(a)) =>
    pure(a)

  _ =>
    validation
}


runPostInstallHook :: Boolean -> MadlibDotJson -> a -> Wish {} a
runPostInstallHook = (isMainPackage, madlibDotJson, passThrough) => pipe(
  .hooks,
  chain(Dictionary.get("postInstall")),
  where {
    Just(script) =>
      do {
        cwd = isMainPackage ? "./" : `madlib_modules/${madlibDotJson.name}`
        IO.putLine(
          `Executing postInstall script for package '${madlibDotJson.name}', it may take a while.`
        )
        _ <- Process.exec("sh", ["-c", script,], { ...Process.DEFAULT_COMMAND_OPTIONS, cwd, })
        IO.putLine(`postInstall script executed for package '${madlibDotJson.name}'`)
        return of({})
      }

    _ =>
      of({})
  },
  mapRej(
    (result) => {
      IO.putLine(result.stdout)
      IO.putLine(result.stderr)
      return {}
    }
  ),
  andDo(of(passThrough))
)(madlibDotJson)


postProcess :: #[Context, List Dependency] -> Dependency -> Validate ValidationOutput -> Wish {} #[Context, List Dependency]
postProcess = (previousContextAndDeps, processedDependency, validation) => where (validation) {
  ValidationError(_, _, _) =>
    of(previousContextAndDeps)

  v =>
    do {
      result = unsafeGetValidationValue(v)
      lockEntry = {
        name: result.madlibDotJson.name,
        version: Version.showVersion(result.madlibDotJson.version),
        buildHash: result.buildHash,
        versionHash: result.versionHash,
        dependencies: result.madlibDotJson.dependencies
          |> fromMaybe([])
          |> map(.url),
      }
      return pipe(
        (validationResult) => ({
          ...validationResult,
          context: validationResult.context
            |> addInstalledPackage(processedDependency.sanitizedUrl)
            |> addLockEntry(processedDependency.url, lockEntry),
        }),
        (validationResult) => validationResult.shouldCopy
          ? #[
            validationResult.context,
            mappend(
              Tuple.snd(previousContextAndDeps),
              fromMaybe([], validationResult.madlibDotJson.dependencies)
            )
          ]
          : #[validationResult.context, Tuple.snd(previousContextAndDeps)],
        runPostInstallHook(false, result.madlibDotJson)
      )(result)
    }
}


processDependency :: Config -> Reporter -> #[Context, List Dependency] -> Dependency -> Wish {} #[Context, List Dependency]
processDependency = (config, reporter, contextAndNextDeps, dependency) => pipe(
  (d) => {
    reporter.validating(d.url)
    return d
  },
  prepareValidationInput(config),
  map(chain(validate(Tuple.fst(contextAndNextDeps), dependency))),
  chain(copyPackageFromTmp(config)),
  map(
    (validation) => {
      where(validation) {
        Valid(a) =>
          reporter.installing(a.madlibDotJson.name)

        NotValid(warnings, a) =>
          do {
            reporter.installing(a.madlibDotJson.name)
            List.forEach((warning) => reporter.reportedWarning(`${a.madlibDotJson.name}: ${warningMessage(warning)}`), warnings)
          }

        ValidationError(warnings, err, maybeA) =>
          do {
            where(maybeA) {
              Just(a) =>
                reporter.installing(a.madlibDotJson.name)

              Nothing =>
                {}
            }
            List.forEach((warning) => reporter.reportedWarning(warningMessage(warning)), warnings)
            reporter.failed(errorMessage(err))
          }
      }

      return tryRecovery(validation)
    }
  ),
  chain((validation) => where(validation) {
    ValidationError(_, _, _) =>
      postProcess(contextAndNextDeps, dependency, validation)

    _ =>
      do {
        result = unsafeGetValidationValue(validation)
        reporter.installed(result.madlibDotJson.name)
        return postProcess(contextAndNextDeps, dependency, validation)
      }
  })
)(dependency)


filterAlreadyInstalledDependencies :: Context -> List Dependency -> List Dependency
filterAlreadyInstalledDependencies = (context, dependencies) => List.filter(
  pipe(
    .sanitizedUrl,
    hasPackageBeenInstalled($, context),
    not
  )
)(dependencies)


processDependencies :: Config -> Reporter -> Context -> List Dependency -> Wish {} #[Context, List Dependency]
processDependencies = (config, reporter, context, dependencies) => pipe(
  filterAlreadyInstalledDependencies(context),
  (deps) => {
    reporter.scheduled(List.length(deps))
    return deps
  },
  pipe(
    map((dependency) => {
      reporter.downloading(dependency.url)
      return pipe(
        downloadIfNotCached(config, reporter.progress(dependency.url)),
        map((result) => where(result) {
          Downloaded(d, FromCache) =>
            do {
              reporter.cached(d.url)
              return result
            }

          Downloaded(d, FromRemote) =>
            do {
              reporter.downloaded(d.url)
              return result
            }

          DownloadError(d, failure) =>
            do {
              reporter.downloadFinished(d.url)
              reporter.failed(downloadErrorMessage(d, failure))
              return result
            }
        })
      )(dependency)
    }),
    parallelN(8)
  ),
  map(
    pipe(
      List.mapMaybe(
        where {
          DownloadError(_, _) =>
            Nothing

          Downloaded(a, _) =>
            Just(a)
        }
      )
    )
  ),
  chain(List.reduceM(processDependency(config, reporter), #[context, []])),
  chain(
    where {
      #[_context, [,]] =>
        of(#[_context, []])

      #[_context, nextDependencies] =>
        processDependencies(config, reporter, _context, nextDependencies)
    }
  )
)(dependencies)


installedDependencyFolders :: Config -> Wish {} (List String)
installedDependencyFolders = (config) => pipe(
  config.readDir,
  discardError(always([]))
)(Constants.MADLIB_MODULES_PATH)


installPackages :: Config -> Reporter -> Context -> String -> Wish {} Context
installPackages = (config, reporter, context, madlibDotJsonPath) => pipe(
  config.readFile,
  mapRej(always(Constants.MADLIB_NOT_FOUND)),
  chain((content) => config.createDir(Constants.MADLIB_MODULES_PATH, { recursive: true }) |> mapRej(always(Constants.MADLIB_NOT_FOUND)) |> andDo(of(content))),
  discardError(identity),
  chain(
    pipe(
      MadlibDotJson.parse,
      bichain(
        pipe(
          IO.putLine,
          always(of(context))
        ),
        (madlibDotJson) => pipe(
          .dependencies,
          fromMaybe([]),
          processDependencies(config, reporter, context),
          chain(
            where {
              #[finalContext, _] =>
                installedDependencyFolders(config)
                  |> chain(
                      pipe(
                        map(installNodeModules(config)),
                        parallelN(4)
                      )
                    )
                  |> chain(runPostInstallHook(true, madlibDotJson))
                  |> chain((_) => ConflictResolver.run(
                      config,
                      madlibDotJson,
                      { lockfileVersion: 1, packages: finalContext.lockEntries }
                    ) |> map(MadlibLock.normalizeDependencies(finalContext.lockEntries))
                      |> map((normalizedLock) => ({ ...finalContext, lockEntries: normalizedLock.packages })))
            }
          )
        )(madlibDotJson)
      )
    )
  )
)(madlibDotJsonPath)







/**
 * prepare runs before everything and takes care of creating a temporary folder
 * as well as reading and saving the content of the package.json file in-memory
 * in order to restore it at it end
 */
prepare :: Config -> String -> Wish String String
prepare = (config, packageDotJsonPath) => pipe(
  always(
    config.createDir(Constants.TEMPORARY_MODULES_PATH, { recursive: true }) |> mapRej(always(""))
  ),
  andDo(of(packageDotJsonPath)),
  chain(
    pipe(
      config.exists,
      mapRej(always("")),
      map(always(packageDotJsonPath))
    )
  ),
  chain(
    (path) => pipe(
      config.exec($, ["i",], Process.DEFAULT_COMMAND_OPTIONS),
      mapRej(.stderr),
      andDo(of(path))
    )("npm")
  ),
  chain(
    pipe(
      config.readFile,
      mapRej(always(""))
    )
  )
)(packageDotJsonPath)


restorePackageDotJson :: Config -> String -> Wish {} {}
restorePackageDotJson = (config, content) => pipe(
  config.writeFile("package.json"),
  mapRej(always({}))
)(content)


writeLockFile :: Config -> Context -> Wish {} {}
writeLockFile = (config, context) => MadlibLock.write(
  config,
  Constants.LOCK_FILE_PATH,
  { lockfileVersion: 1, packages: context.lockEntries }
) |> discardError(always({}))


// Build a minimal Dependency for prefetch-only use (versionRange is unused by download logic).
makePrefetchDep :: String -> Dependency
makePrefetchDep = (url) => ({
  url,
  sanitizedUrl: sanitizeUrl(url),
  versionRange: AnyVersion,
  description: Nothing,
  name: Nothing,
})


// Pre-download every package in the lock file in parallel so the project-local
// and global caches are warm before the main install loop starts.  This turns
// depth-sequential network round-trips into a single parallel fan-out for any
// graph already captured in the lock (e.g. CI with a committed lock file).
prefetchFromLock :: Config -> MadlibLock.MadlibLock -> Wish {} {}
prefetchFromLock = (config, lock) => pipe(
  Dictionary.keys,
  map((url) => downloadIfNotCached(config, (_, _) => {}, makePrefetchDep(url)) |> andDo(of({}))),
  parallelN(16),
  map(always({}))
)(lock.packages)


// Build a starting Context from the previous lock file.  For each locked
// package, we check whether it is already present in madlib_modules/.
// Packages found on disk are marked as installed so the main loop skips
// them (delta install).  All lock entries are pre-loaded into lockEntries
// so the final lock file is the union of old and new packages.
buildDeltaContext :: Config -> MadlibLock.MadlibLock -> Wish {} Context
buildDeltaContext = (config, lock) => pipe(
  Dictionary.toList,
  map(
    (pair) => where(pair) {
      #[url, entry] =>
        config.exists(`${Constants.MADLIB_MODULES_PATH}${entry.name}/madlib.json`)
          |> map((_) => Just(sanitizeUrl(url)))
          |> discardError(always(Nothing))
    }
  ),
  parallelN(16),
  map(
    (results) => ({
      versions: Dictionary.empty,
      installedPackages: List.mapMaybe(identity, results),
      lockEntries: lock.packages,
    })
  )
)(lock.packages)


run :: Config -> Wish {} {}
export run = (config) => {
  reporter = Reporter.make(config.isTTY({}), config.now({}))
  reporter.start({})

  return MadlibLock.load(config, Constants.LOCK_FILE_PATH)
    |> discardError(always(MadlibLock.empty))
    |> chain(
      (lock) => prefetchFromLock(config, lock)
        |> chain((_) => buildDeltaContext(config, lock))
    )
    |> chain(
      (ctx) => pipe(
        prepare(config),
        bichain(
          pipe(
            always("madlib.json"),
            installPackages(config, reporter, ctx),
            mapRej(IO.trace("it failed!"))
          ),
          (packageDotJsonContent) => pipe(
            installPackages(config, reporter, ctx),
            chain((finalCtx) => restorePackageDotJson(config, packageDotJsonContent) |> andDo(of(finalCtx))),
            chainRej((x) => restorePackageDotJson(config, packageDotJsonContent) |> andDo(bad(x)))
          )("madlib.json")
        ),
        chain((finalCtx) => {
          reporter.complete({})
          return writeLockFile(config, finalCtx)
        }),
        chainRej((x) => {
          reporter.complete({})
          return bad(x)
        }),
        andDo(of({}))
      )("package.json")
    )
}
