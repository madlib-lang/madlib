import type { Maybe } from "Maybe"
import type { Version, VersionRange } from "./Version"
import type { LockEntry } from "./MadlibLock"
import type { MadlibLock } from "./MadlibLock"

import { Just, Nothing } from "Maybe"
import Dict from "Dictionary"
import List from "List"
import { identity, ifElse, not } from "Function"

import { AnyVersion } from "./Version"
import { sanitizeUrl } from "./URL"



export alias VersionInfo = {
  version :: Maybe Version,
  range   :: VersionRange
}

export alias Context = {
  versions :: Dictionary String VersionInfo,
  installedPackages :: List String,
  lockEntries :: Dictionary String LockEntry,
}


initialContext :: Context
export initialContext = {
  versions: Dict.empty,
  installedPackages: [],
  lockEntries: Dict.empty,
}


findByName :: String -> Context -> VersionInfo
export findByName = (name, context) => pipe(
  .versions,
  Dict.get(name),
  where {
    Just(found) =>
      found

    Nothing =>
      {
        version: Nothing,
        range: AnyVersion
      }
  }
)(context)

updateEntry :: String -> VersionInfo -> Context -> Context
export updateEntry = (name, versionInfo, context) => pipe(
  .versions,
  Dict.insert(name, versionInfo),
  (versions) => ({ ...context, versions })
)(context)

addInstalledPackage :: String -> Context -> Context
export addInstalledPackage = (sanitizedUrl, context) => pipe(
  .installedPackages,
  ifElse(
    pipe(List.includes(sanitizedUrl), not),
    List.append(sanitizedUrl),
    identity
  ),
  (installedPackages) => ({ ...context, installedPackages })
)(context)

hasPackageBeenInstalled :: String -> Context -> Boolean
export hasPackageBeenInstalled = (sanitizedUrl, context) => pipe(
  .installedPackages,
  List.includes(sanitizedUrl)
)(context)

addLockEntry :: String -> LockEntry -> Context -> Context
export addLockEntry = (url, entry, context) => ({
  ...context,
  lockEntries: Dict.insert(url, entry, context.lockEntries),
})


// Build a starting context from a previously-written lock file so that all
// packages already on disk are treated as installed and skipped in this run.
contextFromLock :: MadlibLock -> Context
export contextFromLock = (lock) => ({
  versions: Dict.empty,
  installedPackages: pipe(Dict.keys, map(sanitizeUrl))(lock.packages),
  lockEntries: lock.packages,
})
