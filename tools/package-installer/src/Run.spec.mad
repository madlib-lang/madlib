import { ErrorWithMessage, assertEquals, test } from "Test"
import { good, bad, mapRej, bichain } from "Wish"
import { always } from "Function"
import ByteArray from "ByteArray"
import Dictionary from "Dictionary"
import IO from "IO"
import String from "String"
import { OK } from "Http"
import { ClientError, Timeout } from "Http"

import type { Config } from "./Config"
import { run } from "./Run"
import { sanitizeUrl } from "./URL"


// ---- Fixtures ----------------------------------------------------------------

DEP_URL = "http://repo.com/test-pkg.zip"
DEP_CACHE_MANIFEST = `.module_cache/${sanitizeUrl(DEP_URL)}/madlib.json`
MODULES_MANIFEST = "./madlib_modules/TestPkg/madlib.json"
LOCK_TEMP_PATH = "./madlib.lock.tmp"

EMPTY_MADLIB_DOT_JSON = `{
  "name": "my-app",
  "version": "1.0.0",
  "main": "src/Main.mad"
}`

LOCAL_MADLIB_DOT_JSON = `{
  "name": "my-app",
  "version": "1.0.0",
  "main": "src/Main.mad",
  "dependencies": [
    { "url": "http://repo.com/test-pkg.zip", "description": "test-pkg" }
  ]
}`

DEP_MADLIB_DOT_JSON = `{
  "name": "TestPkg",
  "version": "0.1.0",
  "main": "src/Main.mad"
}`

DEP_LOCK_JSON = `{
  "lockfileVersion": 1,
  "packages": {
    "http://repo.com/test-pkg.zip": {
      "name": "TestPkg",
      "version": "0.1.0",
      "buildHash": "abc123",
      "versionHash": "def456",
      "dependencies": []
    }
  }
}`

CHILD_URL = "http://repo.com/child-pkg.zip"
CHILD_CACHE_MANIFEST = `.module_cache/${sanitizeUrl(CHILD_URL)}/madlib.json`
CHILD_LOCK_JSON = `{
  "lockfileVersion": 1,
  "packages": {
    "http://repo.com/test-pkg.zip": {
      "name": "TestPkg",
      "version": "0.1.0",
      "buildHash": "abc123",
      "versionHash": "def456",
      "dependencies": ["${CHILD_URL}"]
    },
    "${CHILD_URL}": {
      "name": "ChildPkg",
      "version": "0.2.0",
      "buildHash": "ghi789",
      "versionHash": "jkl012",
      "dependencies": []
    }
  }
}`


baseConfig :: Config
baseConfig = {
  readFile: (_) => bad(IO.UnknownError),
  writeFile: (_, _) => good({}),
  writeBytes: (_, _) => good({}),
  readDir: (_) => good([]),
  createDir: (_, _) => good({}),
  remove: (_, _) => good({}),
  copy: (_, _, _) => good({}),
  rename: (_, _) => good({}),
  unzip: (_, _) => good({}),
  exec: (_, _, _) => good({ exitCode: 0, stdout: "", stderr: "" }),
  exists: (_) => bad({}),
  getBytes: (_) => good({ headers: [], status: OK, body: ByteArray.empty() }),
  getBytesWithProgress: (_, _) => good({ headers: [], status: OK, body: ByteArray.empty() }),
  isTTY: (_) => false,
  now: (_) => 0,
}

DEFAULT_OPTIONS = { interactive: false, overrides: [] }


// ---- run - basic behavior ----------------------------------------------------

test("run - succeeds when no madlib.json exists", (_) =>
  pipe(
    mapRej(always(ErrorWithMessage("run should not fail when madlib.json is absent")))
  )(run(DEFAULT_OPTIONS, baseConfig))
)

test("run - writes lock file after install with no dependencies", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) => path == "madlib.json"
      ? good(EMPTY_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_TEMP_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(String.contains(`"lockfileVersion"`, lockContent), true))
  )(run(DEFAULT_OPTIONS, config))
})

test("run - lock file written contains packages field when no dependencies", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) => path == "madlib.json"
      ? good(EMPTY_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_TEMP_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(String.contains(`"packages"`, lockContent), true))
  )(run(DEFAULT_OPTIONS, config))
})


// ---- run - fresh install from warm cache ------------------------------------

test("run - copies package to madlib_modules when cache is warm", (_) => {
  copyCalled = false
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (_, _) => good({}),
    exists: (path) => path == DEP_CACHE_MANIFEST ? good(true) : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
    copy: (_, _, _) => {
      copyCalled := true
      return good({})
    },
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(copyCalled, true))
  )(run(DEFAULT_OPTIONS, config))
})

test("run - writes package name into lock file after fresh install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_TEMP_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == DEP_CACHE_MANIFEST ? good(true) : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(String.contains(`"TestPkg"`, lockContent), true))
  )(run(DEFAULT_OPTIONS, config))
})

test("run - writes dep URL as key in lock file after fresh install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_TEMP_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == DEP_CACHE_MANIFEST ? good(true) : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(String.contains(DEP_URL, lockContent), true))
  )(run(DEFAULT_OPTIONS, config))
})


// ---- run - delta install (package already on disk) --------------------------

test("run - does not copy package that is already on disk (delta install)", (_) => {
  copyCalled = false
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "./madlib.lock" ? good(DEP_LOCK_JSON)
      : path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == MODULES_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    exists: (path) => path == MODULES_MANIFEST ? good(true) : bad({}),
    copy: (_, _, _) => {
      copyCalled := true
      return good({})
    },
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(copyCalled, false))
  )(run(DEFAULT_OPTIONS, config))
})

test("run - lock file still contains existing entry after delta install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "./madlib.lock" ? good(DEP_LOCK_JSON)
      : path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == MODULES_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_TEMP_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == MODULES_MANIFEST ? good(true) : bad({}),
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(String.contains(`"TestPkg"`, lockContent), true))
  )(run(DEFAULT_OPTIONS, config))
})

test("run - lock file preserves dep URL key after delta install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "./madlib.lock" ? good(DEP_LOCK_JSON)
      : path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == MODULES_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_TEMP_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == MODULES_MANIFEST ? good(true) : bad({}),
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(String.contains(DEP_URL, lockContent), true))
  )(run(DEFAULT_OPTIONS, config))
})


// ---- run - negative-path tests -----------------------------------------------

test("run - lock write failure propagates as a failure", (_) => {
  config = {
    ...baseConfig,
    readFile: (path) => path == "madlib.json"
      ? good(EMPTY_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (_, _) => bad(IO.UnknownError),
  }
  return pipe(
    bichain(
      (_) => good({}),
      (_) => bad(ErrorWithMessage("expected run to fail when lock write fails"))
    )
  )(run(DEFAULT_OPTIONS, config))
})

test("run - npm install failure propagates as a failure", (_) => {
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    exists: (path) => path == DEP_CACHE_MANIFEST || path == "./madlib_modules/TestPkg/package.json"
      ? good(true)
      : bad({}),
    exec: (cmd, _, _) =>
      cmd == "madlib"
        ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
        : bad({ exitCode: 1, stdout: "", stderr: "npm error" }),
    readDir: (_) => good(["TestPkg"]),
  }
  return pipe(
    bichain(
      (_) => good({}),
      (_) => bad(ErrorWithMessage("expected run to fail when npm install fails"))
    )
  )(run(DEFAULT_OPTIONS, config))
})

test("run - download failure propagates as a failure", (_) => {
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    getBytesWithProgress: (_, _) => bad(ClientError(Timeout)),
  }
  return pipe(
    bichain(
      (_) => good({}),
      (_) => bad(ErrorWithMessage("expected run to fail when download fails"))
    )
  )(run(DEFAULT_OPTIONS, config))
})

test("run - copy failure propagates as a failure", (_) => {
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    exists: (path) => path == DEP_CACHE_MANIFEST ? good(true) : bad({}),
    copy: (_, _, _) => bad(IO.UnknownError),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
  }
  return pipe(
    bichain(
      (_) => good({}),
      (_) => bad(ErrorWithMessage("expected run to fail when copy fails"))
    )
  )(run(DEFAULT_OPTIONS, config))
})

test("run - delta install still restores missing transitive deps", (_) => {
  childCopied = false
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "./madlib.lock" ? good(CHILD_LOCK_JSON)
      : path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == MODULES_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : path == CHILD_CACHE_MANIFEST ? good(`{
        "name": "ChildPkg",
        "version": "0.2.0",
        "main": "src/Main.mad"
      }`)
      : bad(IO.UnknownError),
    exists: (path) =>
      path == MODULES_MANIFEST ? good(true)
      : path == CHILD_CACHE_MANIFEST ? good(true)
      : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
    copy: (source, _, _) => {
      if (String.contains(sanitizeUrl(CHILD_URL), source)) do {
        childCopied := true
      } else do {
        {}
      }
      return good({})
    },
  }
  return pipe(
    mapRej(always(ErrorWithMessage("run failed"))),
    chain((_) => assertEquals(childCopied, true))
  )(run(DEFAULT_OPTIONS, config))
})


test("run - unresolved default TTY install does not copy packages or write the lock", (_) => {
  v1Url = "http://repo.com/study-v1.zip"
  v2Url = "http://repo.com/study-v2.zip"
  v1Manifest = `.module_cache/${sanitizeUrl(v1Url)}/madlib.json`
  v2Manifest = `.module_cache/${sanitizeUrl(v2Url)}/madlib.json`
  root = `{
    "name": "my-app",
    "version": "1.0.0",
    "main": "src/Main.mad",
    "dependencies": [{ "url": "${v1Url}" }, { "url": "${v2Url}" }]
  }`
  copied = false
  wroteLock = false
  config = {
    ...baseConfig,
    isTTY: (_) => true,
    readFile: (path) =>
      path == "madlib.json" ? good(root)
      : path == v1Manifest ? good(`{"name":"study","version":"1.0.0","main":"src/Main.mad"}`)
      : path == v2Manifest ? good(`{"name":"study","version":"2.0.0","main":"src/Main.mad"}`)
      : bad(IO.UnknownError),
    exists: (path) => (path == v1Manifest || path == v2Manifest)
      ? good(true)
      : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "hash", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    copy: (_, _, _) => {
      copied := true
      return good({})
    },
    writeFile: (path, _) => {
      if (path == LOCK_TEMP_PATH) do {
        wroteLock := true
      } else do {
        {}
      }
      return good({})
    },
  }
  return pipe(
    bichain(
      (_) => assertEquals(copied == false && wroteLock == false, true),
      (_) => bad(ErrorWithMessage("expected unresolved install to fail"))
    )
  )(run(DEFAULT_OPTIONS, config))
})
