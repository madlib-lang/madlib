import { ErrorWithMessage, assertEquals, test } from "Test"
import { good, bad, mapRej } from "Wish"
import { always } from "Function"
import ByteArray from "ByteArray"
import Dictionary from "Dictionary"
import IO from "IO"
import String from "String"
import { OK } from "Http"

import type { Config } from "./Config"
import { run } from "./Run"


// ---- Fixtures ----------------------------------------------------------------

DEP_URL = "http://repo.com/test-pkg.zip"
DEP_CACHE_MANIFEST = ".module_cache/http___repo_com_test_pkg_zip/madlib.json"
MODULES_MANIFEST = "./madlib_modules/TestPkg/madlib.json"
LOCK_FILE_PATH = "./madlib.lock"

EMPTY_MADLIB_DOT_JSON = `{
  "name": "my-app",
  "version": "1.0.0",
  "main": "src/Main.mad"
}`

LOCAL_MADLIB_DOT_JSON = `{
  "name": "my-app",
  "version": "1.0.0",
  "main": "src/Main.mad",
  "dependencies": [
    { "url": "http://repo.com/test-pkg.zip", "description": "test-pkg" }
  ]
}`

DEP_MADLIB_DOT_JSON = `{
  "name": "TestPkg",
  "version": "0.1.0",
  "main": "src/Main.mad"
}`

DEP_LOCK_JSON = `{
  "lockfileVersion": 1,
  "packages": {
    "http://repo.com/test-pkg.zip": {
      "name": "TestPkg",
      "version": "0.1.0",
      "buildHash": "abc123",
      "versionHash": "def456",
      "dependencies": []
    }
  }
}`


baseConfig :: Config
baseConfig = {
  readFile: (_) => bad(IO.UnknownError),
  writeFile: (_, _) => good({}),
  writeBytes: (_, _) => good({}),
  readDir: (_) => good([]),
  createDir: (_, _) => good({}),
  remove: (_, _) => good({}),
  copy: (_, _, _) => good({}),
  rename: (_, _) => good({}),
  unzip: (_, _) => good({}),
  exec: (_, _, _) => good({ exitCode: 0, stdout: "", stderr: "" }),
  exists: (_) => bad({}),
  getBytes: (_) => good({ headers: [], status: OK, body: ByteArray.empty() }),
  getBytesWithProgress: (_, _) => good({ headers: [], status: OK, body: ByteArray.empty() }),
  isTTY: (_) => false,
  now: (_) => 0,
}


// ---- run - basic behavior ----------------------------------------------------

test("run - succeeds when no madlib.json exists", (_) =>
  run(baseConfig)
    |> mapRej(always(ErrorWithMessage("run should not fail when madlib.json is absent")))
)

test("run - writes lock file after install with no dependencies", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) => path == "madlib.json"
      ? good(EMPTY_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_FILE_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(String.contains(`"lockfileVersion"`, lockContent), true))
})

test("run - lock file written contains packages field when no dependencies", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) => path == "madlib.json"
      ? good(EMPTY_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_FILE_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(String.contains(`"packages"`, lockContent), true))
})


// ---- run - fresh install from warm cache ------------------------------------

test("run - copies package to madlib_modules when cache is warm", (_) => {
  copyCalled = false
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (_, _) => good({}),
    exists: (path) => path == DEP_CACHE_MANIFEST ? good(true) : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
    copy: (_, _, _) => {
      copyCalled := true
      return good({})
    },
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(copyCalled, true))
})

test("run - writes package name into lock file after fresh install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_FILE_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == DEP_CACHE_MANIFEST ? good(true) : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(String.contains(`"TestPkg"`, lockContent), true))
})

test("run - writes dep URL as key in lock file after fresh install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : path == DEP_CACHE_MANIFEST ? good(DEP_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_FILE_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == DEP_CACHE_MANIFEST ? good(true) : bad({}),
    exec: (cmd, _, _) => cmd == "madlib"
      ? good({ exitCode: 0, stdout: "abc123", stderr: "" })
      : good({ exitCode: 0, stdout: "", stderr: "" }),
    readDir: (_) => good(["TestPkg"]),
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(String.contains(DEP_URL, lockContent), true))
})


// ---- run - delta install (package already on disk) --------------------------

test("run - does not copy package that is already on disk (delta install)", (_) => {
  copyCalled = false
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "./madlib.lock" ? good(DEP_LOCK_JSON)
      : path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    exists: (path) => path == MODULES_MANIFEST ? good(true) : bad({}),
    copy: (_, _, _) => {
      copyCalled := true
      return good({})
    },
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(copyCalled, false))
})

test("run - lock file still contains existing entry after delta install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "./madlib.lock" ? good(DEP_LOCK_JSON)
      : path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_FILE_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == MODULES_MANIFEST ? good(true) : bad({}),
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(String.contains(`"TestPkg"`, lockContent), true))
})

test("run - lock file preserves dep URL key after delta install", (_) => {
  lockContent = ""
  config = {
    ...baseConfig,
    readFile: (path) =>
      path == "./madlib.lock" ? good(DEP_LOCK_JSON)
      : path == "madlib.json" ? good(LOCAL_MADLIB_DOT_JSON)
      : bad(IO.UnknownError),
    writeFile: (path, content) => {
      if (path == LOCK_FILE_PATH) {
        lockContent := content
        return {}
      }
      return good({})
    },
    exists: (path) => path == MODULES_MANIFEST ? good(true) : bad({}),
  }
  return run(config)
    |> mapRej(always(ErrorWithMessage("run failed")))
    |> chain((_) => assertEquals(String.contains(DEP_URL, lockContent), true))
})
