import type { Maybe } from "Maybe"
import type { Wish } from "Wish"
import type { Value } from "Json/Value"

import { bad, mapRej } from "Wish"
import { Just, Nothing } from "Maybe"
import { Left, Right } from "Either"
import J from "Json/Parse"
import Print from "Json/Print"
import Dictionary from "Dictionary"
import { always } from "Function"

import type { Config } from "./Config"

import Version from "./Version"
import { FromVersion, UntilVersion } from "./Version"
import Dependency from "./Dependency"


export alias MadlibDotJson = {
  name :: String,
  version :: Version.Version,
  dependencies :: Maybe (List Dependency.Dependency),
  madlibVersion :: Maybe String,
  main :: String,
  bin :: Maybe String,
  importAliases :: Maybe (Dictionary String String),
  hooks :: Maybe (Dictionary String String),
}


makeMadlibDotJson :: String -> String -> Maybe String -> Maybe (List Dependency.Dependency) -> String -> Maybe String -> Maybe (Dictionary String String) -> Maybe (Dictionary String String) -> J.Parser MadlibDotJson
makeMadlibDotJson = (name, version, madlibVersion, dependencies, main, bin, importAliases, hooks) =>
  where(Version.parse(version)) {
    Just(v) =>
      J.succeed({
        name,
        version: v,
        madlibVersion,
        dependencies,
        main,
        bin,
        importAliases,
        hooks,
      })

    Nothing =>
      J.fail(`The version in the madlib.json file is not valid, you provided '${version}', but it should have the form x.y.z where x, y and z are numbers.`)
  }


parser :: J.Parser MadlibDotJson
parser = J.chain8(
  makeMadlibDotJson,
  J.field("name", J.string),
  J.field("version", J.string),
  J.maybe(J.field("madlibVersion", J.string)),
  J.maybe(Dependency.dependencyParser),
  J.field("main", J.string),
  J.maybe(J.field("bin", J.string)),
  J.maybe(J.field("importAliases", J.dict(J.string))),
  J.maybe(J.field("hooks", J.dict(J.string)))
)


parse :: String -> Wish String MadlibDotJson
export parse = pipe(
  J.parse(parser),
  where {
    Left(e) =>
      bad(e)

    Right(a) =>
      of(a)
  }
)


load :: Config -> String -> Wish String MadlibDotJson
export load = (config, path) => pipe(
  config.readFile,
  mapRej(always(`madlib.json file not found at path '${path}'`)),
  chain(parse),
  mapRej((e) => `madlib.json file at path '${path}' is malformed\nError: ${e}`)
)(path)


// ---- Serialization ----------------------------------------------------------

serializeDependency :: Dependency.Dependency -> Value
serializeDependency = (dep) => {
  base = [#["url", Print.string(dep.url)]]

  withDesc = where(dep.description) {
    Just(desc) =>
      [...base, #["description", Print.string(desc)]]

    Nothing =>
      base
  }

  withMin = where(dep.versionRange) {
    Version.VersionRange(minV, _) =>
      [...withDesc, #["minVersion", Print.string(Version.showVersion(minV))]]

    FromVersion(minV) =>
      [...withDesc, #["minVersion", Print.string(Version.showVersion(minV))]]

    _ =>
      withDesc
  }

  withMax = where(dep.versionRange) {
    Version.VersionRange(_, maxV) =>
      [...withMin, #["maxVersion", Print.string(Version.showVersion(maxV))]]

    UntilVersion(maxV) =>
      [...withMin, #["maxVersion", Print.string(Version.showVersion(maxV))]]

    _ =>
      withMin
  }

  return Print.object(withMax)
}

maybeField :: String -> (a -> Value) -> Maybe a -> List #[String, Value]
maybeField = (key, fn, maybeVal) => where(maybeVal) {
  Just(v) =>
    [#[key, fn(v)]]

  Nothing =>
    []
}

serialize :: MadlibDotJson -> String
export serialize = (mdj) => {
  fields =
    [
      #["name", Print.string(mdj.name)],
      #["version", Print.string(Version.showVersion(mdj.version))],
      #["main", Print.string(mdj.main)],
    ]
    ++ maybeField("madlibVersion", Print.string, mdj.madlibVersion)
    ++ maybeField("bin", Print.string, mdj.bin)
    ++ maybeField("dependencies", (deps) => Print.list(serializeDependency, deps), mdj.dependencies)
    ++ maybeField("importAliases", Print.dict(Print.string), mdj.importAliases)
    ++ maybeField("hooks", Print.dict(Print.string), mdj.hooks)

  return Print.print(80, Print.object(fields))
}
