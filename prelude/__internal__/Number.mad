#iftarget llvm

/**
 * Formats a number given as the second parameter to a string containing the
 * number of digits after the decimal point given by the first parameter.
 * @since 0.4.0
 * @example
 * formatDecimal(2, 3.14159) // "3.14"
 */
formatDecimal :: Integer -> Float -> String
export formatDecimal = extern "madlib__number__formatDecimal"

#elseif js

/**
 * Formats a number given as the second parameter to a string containing the
 * number of digits after the decimal point given by the first parameter.
 * @since 0.4.0
 * @example
 * formatDecimal(2, 3.14159) // "3.14"
 */
formatDecimal :: Integer -> Float -> String
export formatDecimal = (digits, value) => #-{
  const n = value.toFixed(digits)
  return isNaN(n) ? "0" : n
}-#

#endif
